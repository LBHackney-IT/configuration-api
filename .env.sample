# Sample environment file.
#
# The API does **not** read `.env` itself. `docker compose` only interpolates the variables that
# docker-compose.yml references with `${...}` — for this repository that is `LBHPACKAGESTOKEN` (plus
# `SONAR_TOKEN` for the test image). The variables under "Runtime" below are read by the API from its
# process environment and are **not** picked up from this file. Export them (or add them to the compose
# service) if you need to override them.

# --- Build (read from .env by docker compose) --------------------------------
# Personal access token with read:packages on the LBHackney-IT GitHub Packages feed.
# Required by `docker compose build` (the Hackney.* packages are not on nuget.org).
LBHPACKAGESTOKEN=your-github-personal-access-token-here

# --- Runtime (NOT read from .env — export these) ------------------------------
# Required: the bucket holding the configuration documents. The object key read is the requested
# configuration type, i.e. `GET /api/v1/configuration?types=<type>` reads object `<type>`.
# The `configuration-api` compose service has no environment block at all, so this must be exported
# before `make serve` (or added to that service).
CONFIGURATION_S3_BUCKETNAME=configuration-api-configurations

# Optional: point the S3 client at LocalStack instead of AWS S3. When set, the client uses
# path-style addressing and dummy credentials, so no real AWS access is needed.
# CONFIGURATION_S3_URL=http://localhost:4566

# Needed only when CONFIGURATION_S3_URL is not set, i.e. when talking to real AWS S3.
# AWS_REGION=eu-west-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
